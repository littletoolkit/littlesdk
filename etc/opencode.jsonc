// NOTE: This is managed by the SDK and is readonly
{
	"$schema": "https://opencode.ai/config.json",
	"instructions": [".opencode/rules/*"],
	// Third-party plugin, pinned to avoid silent upgrades. Enabled alongside
	// the removal of the Lattice MCP; vet provenance before bumping since this
	// config is SDK-managed and read-only.
	"plugin": ["@dietrichgebert/ponytail@4.10.0"],
	"mcp": {
		"playwright": {
			"type": "local",
			"command": [
				"xvfb-run",
				"-a",
				"env",
				"HEADLESS=true",
				"PLAYWRIGHT_HEADLESS=true",
				"PW_HEADLESS=1",
				"bun",
				"x",
				"-y",
				"@playwright/mcp@latest"
			],
			"enabled": true
		},
		"context7": {
			"type": "local",
			"command": [
				"bun",
				"x",
				"-y",
				"@upstash/context7-mcp",
				"--api-key",
				"{env:CONTEXT7_API_KEY}"
			],
			"enabled": true
		}
	}
}
// EOF
